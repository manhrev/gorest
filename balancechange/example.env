APP_VERSION=dev
CORS_ALLOWED_ORIGINS=*

HTTP_HOST=localhost
HTTP_PORT=8080

LOG_LEVEL=

TRACING_ENABLED=false
TRACING_COLLECTOR_HOST=localhost
TRACING_SECURE=false
TRACING_TRACE=true
TRACING_METRIC=false
TRACING_LOG=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=balancechange
POSTGRES_SSLMODE=disable
POSTGRES_MIGRATE=false

SHUTDOWN_TIMEOUT=5s

# required; clients send it as the X-API-Key header
API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
